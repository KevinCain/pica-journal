{
  "name": "pica-journal",
  "version": "0.3.1",
  "description": "Answer the pica journal: items a writer sends from pica with ☞ come to Claude, and Claude's replies appear under them.",
  "author": { "name": "Kevin Cain" },
  "homepage": "https://picaimprint.app/journal",
  "repository": "https://github.com/KevinCain/pica-journal",
  "license": "MIT",
  "keywords": ["pica", "journal", "writing", "channel"],
  "mcpServers": {
    "journal": { "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/lib/channel.mjs"] }
  },
  "channels": [{ "server": "journal" }]
}
